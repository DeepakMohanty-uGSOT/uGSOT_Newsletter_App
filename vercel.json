{
  "version": 2,
  "buildCommand": "pnpm run vercel-build",
  "outputDirectory": "frontend/ugsot/dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
